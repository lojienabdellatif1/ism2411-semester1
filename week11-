print("---Exercise 1---Customer Dictionary and Lookup---")
customer = {
    "name":"alice",
    "email": "alice@example.com", #be careful with typing issues 
    "tier": "gold",
    "ytd_spend":12400
}
print(customer["name"])
print(customer["email"])
print(customer["tier"])
print(customer["ytd_spend"])

print("---exercise 2--- update and add")

customer['phone']= '55-5555' #add new key value to the dictionary
print(customer)

#update 
customer['tier']='platinum' #update the value of the key
print(customer)


print("---exercise 3--- safe lookup")

print(customer.get('Name', 'key not found'))
print(customer.get("Email", "no email on file"))

print("---exercise 4--- iterate")

for key, value in customer.items():
    print(f"{key}: {value}")


print("---exercise 5--- lookup table for discounts")
tier_discount= {
    "bronze": 0, 
    "silver": 0.05,
    "gold": 0.1, 
    "platinum": 0.15
    }

purchase= 200
discount_rate= tier_discount.get(customer['tier'], 0) #get the discount rate based on the tier, default to 0 if not found
final_price= purchase * (1- discount_rate)
print(f"Final price after discount: ${final_price:.2f}")

print("---exercise 6--- list of dictionaries")
customers= [
    {"name": "alice", "tier": "gold", "ytd_spend": 12400},
    {"name": "bob", "tier": "silver", "ytd_spend": 8000},
    {"name": "charlie", "tier": "bronze", "ytd_spend": 3000}
]

for record in customers:
    rate= tier_discount.get(record['tier'], 0)
    discount= 300 * rate
    print(f"{record['name']} ({record['tier']}): Discount on $300 purchase: ${discount:.2f}")

    print("---exercise 7--- nested catalog")
catalog= {
    "Widget A": {"price":9.99, "stock": 150},
    "Gadget C": {"price":49.99, "stock": 8},
}

for product_name, product_details in catalog.items():
    if product_details['stock'] < 20:
        print(f"LOW STOCK: {product_name} -only {product_details['stock']} left in stock")

        print("---exercise 8--- sales by region")
        transactions= [
            {"region":"south", "amount": 300},
            {"region":"north", "amount": 150},
            {"region":"south", "amount": 200},
        ]

        sales_by_region= {}
        for sale in transactions:
            region= sale['region']
            amount= sale['amount']
            sales_by_region[region]= sales_by_region.get(region, 0) + amount

print(sales_by_region)

for region in sorted (sales_by_region):
    print(f"{region}: ${sales_by_region[region]:.2f}")
    